---
import "../styles/site.css";
import "../ore-ui-react/styles.css";
import logo from "../assets/oreuilib_logo.png";
import { groupFor, groups, pageHref, pages, type DocLink } from "../nav";

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	id: string;
	title: string;
	description: string;
	headings: Heading[];
}

const { id, title, description, headings } = Astro.props;
const group = groupFor(id);
const index = pages.findIndex((page) => page.id === id);
const previous: DocLink | undefined = index > 0 ? pages[index - 1] : undefined;
const next: DocLink | undefined = index >= 0 && index < pages.length - 1 ? pages[index + 1] : undefined;
const toc = headings.filter((heading) => heading.depth === 2);
const base = import.meta.env.BASE_URL;
---

<html lang="en" data-base={base}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} — Ore UI Library</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
		/>
		<style>
			html:not(.font-ready) .pixel-canvas { visibility: hidden; }
			.font-loading {
				position: fixed;
				inset: 0;
				z-index: 10000;
				display: flex;
				align-items: center;
				justify-content: center;
				background: #1a1a1a;
				color: #e5e5e5;
				font-family: "Space Grotesk", sans-serif;
				font-size: 16px;
			}
			html.font-ready .font-loading { display: none; }
		</style>
		<script is:inline>
			const minecraftSevenUrl = "https://www.minecraft.net/etc.clientlibs/minecraftnet/clientlibs/clientlib-site/resources/fonts/Minecraft-Seven_v2.woff2";
			const minecraftTenUrl = "https://www.minecraft.net/etc.clientlibs/minecraftnet/clientlibs/clientlib-site/resources/fonts/Minecraft-Tenv2.woff2";
			const loading = () => document.querySelector(".font-loading");
			(async () => {
				try {
					const loadFont = async (family, url) => {
						const response = await fetch(url);
						if (!response.ok) throw new Error(family + ": " + response.status);
						const bytes = await response.arrayBuffer();
						const source = URL.createObjectURL(new Blob([bytes], { type: "font/woff2" }));
						const face = new FontFace(family, `url(${source})`, {
							weight: "400",
							style: "normal",
							display: "block",
						});
						await face.load();
						document.fonts.add(face);
					};
					await Promise.all([
						loadFont("Minecraft Seven", minecraftSevenUrl),
						loadFont("Minecraft Ten", minecraftTenUrl),
					]);
					document.documentElement.classList.add("font-ready");
				} catch (error) {
					const node = loading();
					if (node) node.textContent = "Could not load Minecraft fonts (check network)";
					console.error(error);
					document.documentElement.classList.add("font-ready");
				}
			})();
		</script>
	</head>
	<body>
		<div class="font-loading">Loading</div>
		<div class="pixel-canvas" data-pixel-canvas style="--pixel: 1.5px;">
			<div class="min-h-screen w-full bg-[#1A1A1A] text-[#e5e5e5] relative flex flex-col">
				<canvas class="pixel-blast" data-pixel-blast></canvas>

				<header class="sticky top-0 z-50 w-full">
					<div class="ore-tabbar ore-tabbar--md">
						<div class="ore-tabbar__center">
							<div class="ore-tabbar__face" style="justify-content: flex-start; padding-inline: 16px;">
								<a href={pageHref("index")} class="inline-flex items-center shrink-0 no-underline" style="gap: 10px;">
									<img src={logo.src} alt="Ore UI Library" width="36" height="36" class="object-contain" style="height: 36px; width: 36px; image-rendering: pixelated;" />
									<span class="ore-tabbar__title" style="font-size: 24px;">Ore UI Library</span>
								</a>
							</div>
							<span class="ore-tabbar__shadow" aria-hidden="true"></span>
						</div>
						<nav class="ore-tabbar__side" aria-label="Top navigation">
							<a href={pageHref("index")} class="ore-tabbar-btn ore-tabbar-btn--md ore-tabbar-btn--has-text no-underline">
								<span class="ore-tabbar-btn__face">
									<span class="ore-tabbar-btn__content"><span class="ore-tabbar-btn__label">Docs</span></span>
								</span>
								<span class="ore-tabbar-btn__shadow" aria-hidden="true"></span>
							</a>
							<a href={pageHref("install")} class="ore-tabbar-btn ore-tabbar-btn--md ore-tabbar-btn--has-text no-underline">
								<span class="ore-tabbar-btn__face">
									<span class="ore-tabbar-btn__content"><span class="ore-tabbar-btn__label">Install</span></span>
								</span>
								<span class="ore-tabbar-btn__shadow" aria-hidden="true"></span>
							</a>
							<a href={pageHref("buttons")} class="ore-tabbar-btn ore-tabbar-btn--md ore-tabbar-btn--has-text no-underline">
								<span class="ore-tabbar-btn__face">
									<span class="ore-tabbar-btn__content"><span class="ore-tabbar-btn__label">Buttons</span></span>
								</span>
								<span class="ore-tabbar-btn__shadow" aria-hidden="true"></span>
							</a>
							<a href={pageHref("design-system")} class="ore-tabbar-btn ore-tabbar-btn--md ore-tabbar-btn--has-text no-underline">
								<span class="ore-tabbar-btn__face">
									<span class="ore-tabbar-btn__content"><span class="ore-tabbar-btn__label">Design</span></span>
								</span>
								<span class="ore-tabbar-btn__shadow" aria-hidden="true"></span>
							</a>
							<a href="https://www.figma.com/community/file/1675191037788105821" target="_blank" rel="noopener noreferrer" class="ore-tabbar-btn ore-tabbar-btn--md ore-tabbar-btn--has-text no-underline">
								<span class="ore-tabbar-btn__face">
									<span class="ore-tabbar-btn__content"><span class="ore-tabbar-btn__label">Figma</span></span>
								</span>
								<span class="ore-tabbar-btn__shadow" aria-hidden="true"></span>
							</a>
						</nav>
					</div>
				</header>

				<div class="pixel-page-layout gap-8 lg:gap-12 xl:gap-16 p-4 lg:p-8 pb-16 flex-1 w-full max-w-[calc(1033*var(--pixel))] mx-auto relative z-10 items-start">
					<aside class="w-full sticky top-[calc(51*var(--pixel))] self-start">
						<nav class="ore-navbar ore-navbar--md border-2 border-black" aria-label="Documentation navigation">
							<div class="ore-navbar__groups">
								{
									groups.map((section) => (
										<div class="ore-navbar__group" role="group">
											<div class="ore-nav-item ore-nav-item--header">
												<span class="ore-nav-item__bg">
													<span class="ore-nav-item__content">
														<span class="ore-nav-item__leading">
															<span class="ore-nav-item__label">{section.label}</span>
														</span>
													</span>
												</span>
											</div>
											{section.items.map((item) => (
												<a
													href={pageHref(item.id)}
													class:list={[
														"ore-nav-item ore-nav-item--item no-underline",
														item.id === id ? "ore-nav-item--selected" : "",
													]}
												>
													<span class="ore-nav-item__bg">
														<span class="ore-nav-item__content">
															<span class="ore-nav-item__leading">
																<span class="ore-nav-item__label">{item.label}</span>
															</span>
														</span>
													</span>
												</a>
											))}
										</div>
									))
								}
							</div>
						</nav>
					</aside>

					<main class="min-w-0 max-w-[calc(507*var(--pixel))] mx-auto flex flex-col gap-2 relative z-10 w-full px-1 lg:px-4 pt-5 lg:pt-6">
						<div class="pb-6 mb-2">
							<div class="flex flex-row flex-wrap items-center gap-2 text-xs text-[#888888] mb-5">
								<a href={pageHref("index")} class="font-sans text-xs text-[#888888] hover:text-white transition-colors">Docs</a>
								<span class="text-[#444444]">/</span>
								<span class="font-sans text-xs text-[#888888]">{group?.label}</span>
								<span class="text-[#444444]">/</span>
								<span class="font-sans text-xs text-[#a3a3a3]">{title}</span>
							</div>
							<div class="flex flex-row flex-wrap items-center gap-3 mb-4">
								<span class="font-block font-bold text-sm inline-block leading-10 bg-[#242424] text-[#a3a3a3] pixel-border-dashed px-3 py-1">v1.0.0</span>
								<span class="pixel-badge font-block font-bold inline-flex items-center pixel-border select-none" style="background:#387E24;color:#ffffff;border-color:#50913D;">JAVA MOD LIBRARY</span>
							</div>
							<h1 class="pixel-text font-block font-bold tracking-pixel text-white text-3xl leading-30 mt-2 mb-5">{title}</h1>
							<p class="font-sans text-base text-[#a3a3a3] mb-0">{description}</p>
						</div>
						<div class="pixel-dashed-b" style="height: calc(1 * var(--pixel)); width: 100%; margin-block: calc(10 * var(--pixel));"></div>
						<div class="doc">
							<slot />
						</div>
						<div class="flex flex-row gap-5 mt-8 pt-4">
							{
								previous && (
									<a
										href={pageHref(previous.id)}
										class="flex-1 flex flex-col p-5 bg-[#1e1e1e] pixel-border-dashed pixel-border-dashed-hover hover:bg-[#242424] transition-all text-left no-underline gap-2"
									>
										<span class="font-sans text-xs text-[#888888]">Previous</span>
										<span class="font-block font-bold text-base text-white">← {previous.label}</span>
									</a>
								)
							}
							{
								next && (
									<a
										href={pageHref(next.id)}
										class="flex-1 flex flex-col p-5 bg-[#1e1e1e] pixel-border-dashed pixel-border-dashed-hover hover:bg-[#242424] transition-all text-right no-underline gap-2"
									>
										<span class="font-sans text-xs text-[#888888]">Next</span>
										<span class="font-block font-bold text-base text-white">{next.label} →</span>
									</a>
								)
							}
						</div>
					</main>

					<aside class="w-full sticky top-[calc(51*var(--pixel))] self-start">
						<nav class="ore-navbar ore-navbar--md border-2 border-black" aria-label="On this page">
							<div class="ore-navbar__groups">
								<div class="ore-navbar__group" role="group">
									<div class="ore-nav-item ore-nav-item--header">
										<span class="ore-nav-item__bg">
											<span class="ore-nav-item__content">
												<span class="ore-nav-item__leading">
													<span class="ore-nav-item__label">On this page</span>
												</span>
											</span>
										</span>
									</div>
									{
										toc.map((heading) => (
											<a href={`#${heading.slug}`} class="ore-nav-item ore-nav-item--item no-underline">
												<span class="ore-nav-item__bg">
													<span class="ore-nav-item__content">
														<span class="ore-nav-item__leading">
															<span class="ore-nav-item__label">{heading.text}</span>
														</span>
													</span>
												</span>
											</a>
										))
									}
								</div>
							</div>
						</nav>
					</aside>
				</div>

				<footer class="w-full pixel-border-dashed-t px-6 lg:px-10 py-5 flex flex-wrap items-center justify-between gap-4 text-xs text-[#666666] bg-[#181818]/90 backdrop-blur-sm relative z-10">
					<span class="font-sans text-xs text-[#666666]">Ore UI Library 1.0.0 · PolyForm Noncommercial 1.0.0</span>
					<span class="font-sans text-xs text-[#888888]">Not an official Minecraft product. Not affiliated with or endorsed by Mojang Studios or Microsoft.</span>
				</footer>
			</div>
		</div>
		<script src="../scripts/shell.js"></script>
	</body>
</html>
